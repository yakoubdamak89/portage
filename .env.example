# ──────────────────────────────────────────────────────────────────────────────
# Portage Pro – Environment Variables
# Copy this file to .env and fill in all required values.
# ──────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=portagedb
POSTGRES_USER=portage
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Spring Boot Backend ────────────────────────────────────────────────────────
# A random base64 string of at least 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_STRING
JWT_EXPIRATION=86400000

# ── Mail (optional – leave as-is to disable email sending) ────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# ── Frontend exposure ──────────────────────────────────────────────────────────
# Port on which Nginx (frontend) will listen on the host.
# When using a reverse proxy (e.g. Nginx on the host or Traefik), set to 127.0.0.1:8090
# so that the port is not publicly exposed; the host reverse proxy forwards traffic.
FRONTEND_PORT=80
