# =============================================================================
# portage.service – systemd unit for the Portage Docker Compose stack
#
# Install with:  bash scripts/setup-systemd.sh
#
# This service ensures all Docker Compose containers (postgres, backend,
# frontend) start automatically on boot and can be managed with standard
# systemctl commands:
#   systemctl start portage
#   systemctl stop portage
#   systemctl restart portage
#   systemctl status portage
# =============================================================================

[Unit]
Description=Portage Pro – Docker Compose Stack
Documentation=https://github.com/IngeniousDevelopersINDEV/portage
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__DEPLOY_PATH__
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose up -d --build --remove-orphans
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
